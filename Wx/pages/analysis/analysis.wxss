.analysis-page {
  padding: 32rpx;
  font-size: 32rpx;
  color: #333;
}

.analysis-container {
  min-height: 100vh;
  background: #eafaf1;
  padding-bottom: 120rpx;
}

/* 概览区域 */
.overview-section {
  padding: 30rpx 20rpx;
}

.overview-card {
  background: rgba(79, 157, 166, 0.12);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  color: #4f9da6;
}

.overview-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
}

.overview-stat {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 图表区域 */
.chart-section {
  padding: 0 20rpx 30rpx;
}

.chart-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(79,157,166,0.06);
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4f9da6;
  margin-bottom: 30rpx;
  text-align: center;
}

.chart-container {
  position: relative;
  height: 340rpx;
  width: 100%;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
}

.chart-canvas {
  width: 100%;
  height: 100%;
  display: block;
  margin: 0 auto;
  margin-top: -30rpx;
  margin-left: 20rpx;
}

/* 图例 */
.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

/* 趋势分析 */
.trend-section {
  padding: 0 20rpx 30rpx;
}

.trend-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(79,157,166,0.06);
}

.trend-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4f9da6;
  margin-bottom: 30rpx;
  text-align: center;
}

.trend-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.trend-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ffffff;
}

.trend-icon.excellent {
  background: #4f9da6;
  opacity: 0.7;
}

.trend-icon.good {
  background: #4f9da6;
  opacity: 0.7;
}

.trend-icon.warning {
  background: #b2bec3;
  opacity: 0.7;
}

.trend-icon.danger {
  background: #ff4d4f;
  opacity: 0.7;
}

.trend-info {
  flex: 1;
}

.trend-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.trend-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 学习建议 */
.suggestion-section {
  padding: 0 20rpx 30rpx;
}

.suggestion-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(79,157,166,0.06);
}

.suggestion-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4f9da6;
  margin-bottom: 30rpx;
  text-align: center;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.suggestion-number {
  width: 40rpx;
  height: 40rpx;
  background: #4f9da6;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
  opacity: 0.7;
}

.suggestion-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  min-width: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
}

.radar-legend {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 8px;
}
.radar-legend-item {
  display: flex;
  align-items: center;
  margin: 0 8px 4px 0;
}
.radar-legend-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  margin-right: 4px;
}
.radar-legend-text {
  font-size: 13px;
  color: #4f9da6;
}

.bar-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 10rpx;
}
.bar-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.bar-legend-color {
  width: 28rpx;
  height: 18rpx;
  border-radius: 4rpx;
}
.bar-legend-color.my-score {
  background: #4f9da6;
}
.bar-legend-color.class-score {
  background: #bfbfbf;
}
.bar-legend-text {
  font-size: 22rpx;
  color: #666;
}

.bar-extra-info {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 18rpx;
  margin-bottom: 6rpx;
}
.bar-extra-info text {
  font-size: 26rpx;
  color: #4f9da6;
  background: #eafaf1;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  font-weight: bold;
}

.bar-extra-info-list {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 10rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}
.bar-extra-info-list text {
  font-size: 24rpx;
  color: #333;
  background: #f6f6f6;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  margin-bottom: 6rpx;
}

.stat-section {
  padding: 0 20rpx 30rpx;
}
.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(79,157,166,0.06);
  margin-top: 18rpx;
}
.stat-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #4f9da6;
  margin-bottom: 28rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
.stat-info-row {
  display: flex;
  justify-content: space-around;
  margin: 28rpx 0 0 0;
  background: rgba(79,157,166,0.08);
  border-radius: 16rpx;
  padding: 18rpx 0 8rpx 0;
}
.stat-info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-info-label {
  font-size: 24rpx;
  color: #4f9da6;
  margin-bottom: 6rpx;
  font-weight: 500;
}
.stat-info-value {
  font-size: 32rpx;
  color: #4f9da6;
  font-weight: bold;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(79,157,166,0.06);
}
.stat-info-list {
  margin-top: 10rpx;
}
.stat-info-list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.stat-info-list-label {
  font-size: 26rpx;
  color: #4f9da6;
  font-weight: bold;
  min-width: 180rpx;
}
.stat-info-list-value {
  font-size: 26rpx;
  color: #4f9da6;
  background: #eafaf1;
  border-radius: 16rpx;
  padding: 8rpx 18rpx;
  word-break: break-all;
  font-weight: bold;
  margin-left: 8rpx;
} 

/* 针对雷达图模块单独拉高高度 */
.chart-section:first-child .chart-container {
  height: 340rpx;
} 