.login-container {
  min-height: 100vh;
  background: #eafaf1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 修复右上角色块问题，确保无多余装饰 */

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 60rpx;
  z-index: 1;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(79, 157, 166, 0.10);
  background: #fff;
}

.login-mokuai {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79,157,166,0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 90vw;
  max-width: 600rpx;
  padding: 60rpx 36rpx 48rpx 36rpx;
  margin: 250rpx auto 0 auto;
}

.logo-card {
  padding: 32rpx 0 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.app-name {
  display: block;
  font-size: 50rpx;
  font-weight: bold;
  color: #4f9da6;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(79, 157, 166, 0.10);
  text-align: center;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: #b2bec3;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 登录方式区域 */
.login-methods {
  width: 100%;
  max-width: 600rpx;
  z-index: 1;
}

.login-method {
  margin-bottom: 40rpx;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.wechat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* 分割线 */
.divider {
  position: relative;
  text-align: center;
  margin: 40rpx 0;
}

.divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.divider-text {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0 30rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* 输入框组 */
.input-group {
  margin-bottom: 30rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #b2bec3;
  border-radius: 44rpx;
  padding: 0 40rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
  transition: border 0.3s, box-shadow 0.3s;
  box-shadow: 0 2rpx 12rpx rgba(79, 157, 166, 0.08);
}

.input-field:focus {
  border: 2rpx solid #4f9da6;
  box-shadow: 0 4rpx 24rpx rgba(79, 157, 166, 0.13);
}

.input-field::placeholder {
  color: #b2bec3;
  font-size: 28rpx;
}

/* 密码登录按钮 */
.password-login-btn {
  width: 100%;
  height: 88rpx;
  background: #4f9da6;
  border: none;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(79, 157, 166, 0.10);
  margin-top: 10rpx;
  transition: background 0.3s, transform 0.1s;
  letter-spacing: 2rpx;
}

.password-login-btn:active {
  background: #357a81;
  transform: scale(0.97);
}

/* 底部说明 */
.footer {
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
  z-index: 1;
}

.footer-text {
  font-size: 24rpx;
  color: #b2bec3;
  line-height: 1.5;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  min-width: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4f9da6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #4f9da6;
} 