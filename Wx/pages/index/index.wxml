<!--index.wxml-->
<view class="index-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <view class="user-avatar-text">{{userInfo.name ? userInfo.name.slice(-2) : '未登录'}}</view>
      <view class="user-details">
        <text class="user-name">{{userInfo.name || '未登录'}}</text>
        <text class="user-id">{{userInfo.student_id || '请先登录'}}</text>
        <text class="user-major">{{userInfo.major || ''}}</text>
      </view>
    </view>
    <view class="logout-btn prominent" bindtap="handleLogout" wx:if="{{userInfo.name}}">
      <text class="logout-text">退出</text>
    </view>
  </view>

  <!-- 统计概览 -->
  <view class="stats-section">
    <view class="stat-card" bindtap="navigateToGrade">
      <view class="stat-icon">📊</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.totalCourses || 0}}</text>
        <text class="stat-label">总课程</text>
      </view>
    </view>
    <view class="stat-card" bindtap="navigateToGrade">
      <view class="stat-icon">📈</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.averageScore || 0}}</text>
        <text class="stat-label">平均分</text>
      </view>
    </view>
    <view class="stat-card" bindtap="navigateToAnalysis">
      <view class="stat-icon">🎯</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.passRate || 0}}%</text>
        <text class="stat-label">及格率</text>
      </view>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="quick-actions">
    <view class="section-title">快捷功能</view>
    <view class="action-grid">
      <view class="action-item" bindtap="navigateToGrade">
        <view class="action-icon">📋</view>
        <text class="action-text">成绩查询</text>
      </view>
      <view class="action-item" bindtap="navigateToCourse">
        <view class="action-icon">📚</view>
        <text class="action-text">课程管理</text>
      </view>
      <view class="action-item" bindtap="navigateToAnalysis">
        <view class="action-icon">📊</view>
        <text class="action-text">成绩分析</text>
      </view>
      <view class="action-item" bindtap="showSchedule">
        <view class="action-icon">📅</view>
        <text class="action-text">课程表</text>
      </view>
    </view>
  </view>

  <!-- 最近成绩 -->
  <view class="recent-grades" wx:if="{{recentGrades.length > 0}}">
    <view class="section-title">最近成绩</view>
    <view class="grade-list">
      <view class="grade-item" wx:for="{{recentGrades}}" wx:key="id">
        <view class="course-info">
          <text class="course-name">{{item.course_name}}</text>
          <text class="course-type">{{item.course_type}}</text>
        </view>
        <view class="score {{item.score >= 90 ? 'excellent' : item.score >= 80 ? 'good' : item.score >= 60 ? 'pass' : 'fail'}}">
          {{item.score}}
        </view>
      </view>
    </view>
    <view class="view-more" bindtap="navigateToGrade">
      <text class="view-more-text">查看更多成绩</text>
      <text class="view-more-arrow">></text>
    </view>
  </view>

  <!-- 学习提醒 -->
  <view class="study-reminder" wx:if="{{studyTips.length > 0}}">
    <view class="section-title">学习提醒</view>
    <view class="tip-list">
      <view class="tip-item" wx:for="{{studyTips}}" wx:key="index">
        <view class="tip-icon">💡</view>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-mask" wx:if="{{isLoading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
